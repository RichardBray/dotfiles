(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
  macos-dev-names-exclude (
    "MX Master"
  )
)

(defvar
  tap-timeout 200
  hold-timeout 200
)

(defsrc
  caps a s d f g h j k l ; spc
  q w e u
  lctl
  f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12
)

(defchordsv2
  (j k) bspc 200 first-release ()
)

(deflayer base
  esc
  (tap-hold $tap-timeout $hold-timeout a lsft)
  (tap-hold $tap-timeout $hold-timeout s lctl)
  (tap-hold $tap-timeout $hold-timeout d lalt)
  (tap-hold $tap-timeout $hold-timeout f lmet)
  g h
  (tap-hold $tap-timeout $hold-timeout j rmet)
  (tap-hold $tap-timeout $hold-timeout k ralt)
  (tap-hold $tap-timeout $hold-timeout l rctl)
  (tap-hold $tap-timeout $hold-timeout ; rsft)
  spc
  q w e u
  (layer-switch editor)
  ;; standard macOS function row (f5 dictation has no HID code, left literal)
  brdn bru mctl lpad f5 dnd prev pp next mute vold volu
)

(deflayer editor
  esc
  (tap-hold $tap-timeout $hold-timeout a lsft)
  (tap-hold $tap-timeout $hold-timeout s lctl)
  (tap-hold $tap-timeout $hold-timeout d lalt)
  (tap-hold $tap-timeout $hold-timeout (multi lmet t) lmet)
  g h
  (tap-hold $tap-timeout $hold-timeout j rmet)
  (tap-hold $tap-timeout $hold-timeout k ralt)
  (tap-hold $tap-timeout $hold-timeout l rctl)
  (tap-hold $tap-timeout $hold-timeout ; rsft)
  spc
  (multi lmet z)
  del
  l
  (multi lmet z)
  (layer-switch base)
  brdn bru mctl lpad f5 dnd prev pp next mute vold volu
)
