#!/bin/sh
#
# agenda [days]  -- list upcoming calendar events, colored per calendar.
#   agenda        upcoming events today + tomorrow (default)
#   agenda 0      remaining events today only
#   agenda 7      next 7 days
#
# Reads the local synced calendar via icalBuddy. No network / API keys.

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
CAL_LIB="$HOME/.local/share/cal/events.sh"
[ -f "$CAL_LIB" ] || CAL_LIB="$(cd "$(dirname "$0")/../lib" 2>/dev/null && pwd)/events.sh"
. "$CAL_LIB"

case "$1" in
  -h|--help)
    cat <<'EOF'
agenda: print upcoming macOS calendar events to stdout, read-only, no network.

Usage:
  agenda        upcoming events today + tomorrow (default)
  agenda 0      remaining events today only
  agenda 7      next 7 days
  agenda -1     include yesterday too (past events shown muted)
EOF
    exit 0 ;;
esac

days="${1:-1}"
now=$(date +%s)
today=$(date +%Y-%m-%d)
tomorrow=$(date -v+1d +%Y-%m-%d)
yesterday=$(date -v-1d +%Y-%m-%d)

# Color only when writing to a terminal.
if [ -t 1 ]; then COLOR=1; else COLOR=0; fi
BOLD=; DIM=; RST=
if [ "$COLOR" = 1 ]; then
  BOLD=$(printf '\033[1m'); DIM=$(printf '\033[2m'); RST=$(printf '\033[0m')
fi

# fg <calendar> -> ANSI foreground escape for that calendar (empty if no color)
fg() {
  [ "$COLOR" = 1 ] || return 0
  printf '\033[38;5;%sm' "$(cal_color "$1")"
}

# Negative days = look back; include past events (rendered muted below).
if [ "$days" -lt 0 ]; then
  events=$(cal_events "$days" | sort -n)
else
  events=$(cal_events "$days" | sort -n | awk -F'|' -v now="$now" '$1 > now')
fi

if [ -z "$events" ]; then
  printf '%sNo upcoming events.%s\n' "$DIM" "$RST"
  exit 0
fi

# Events, grouped by day, each dot + time tinted by its calendar.
last_date=""
printf '%s\n' "$events" | while IFS='|' read -r epoch date start title cal; do
  if [ "$date" != "$last_date" ]; then
    case "$date" in
      "$today")     label="Today" ;;
      "$tomorrow")  label="Tomorrow" ;;
      "$yesterday") label="Yesterday" ;;
      *)           label="" ;;
    esac
    pretty=$(date -j -f "%Y-%m-%d" "$date" "+%a %d %b" 2>/dev/null)
    if [ -n "$label" ]; then header="$label  $DIM$pretty$RST"; else header="$pretty"; fi
    printf '\n%s%s%s\n' "$BOLD" "$header" "$RST"
    last_date="$date"
  fi
  delta=$((epoch - now))
  if [ "$delta" -lt 0 ]; then
    c="$DIM"; when="$(cal_countdown $((-delta))) ago"   # past -> muted
  else
    c=$(fg "$cal"); when="in $(cal_countdown "$delta")"
  fi
  printf '  %s●%s %s%s%s  %-32s %s%s%s\n' \
    "$c" "$RST" "$c" "$start" "$RST" "$title" "$DIM" "$when" "$RST"
done

# Legend: which color maps to which calendar.
printf '\n%sCalendars:%s ' "$DIM" "$RST"
printf '%s\n' "$events" | cut -d'|' -f5 | sort -u | while IFS= read -r cal; do
  [ -z "$cal" ] && continue
  printf '%s●%s %s   ' "$(fg "$cal")" "$RST" "$cal"
done
printf '\n'
